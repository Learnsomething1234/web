<% layout("/layouts/boilerplate")%>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <form method="post" action="/listing" class="needs-validation" novalidate enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" name="listing[title]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" class="form-control" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for=" image " class="form-label">Upload Listing Image</label>
                        <input type="file" name="listing[image]" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input type="number" name="listing[price]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for=" location " class="form-label ">Location</label>
                        <input type="text " name="listing[location]" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" name="listing[country]" class="form-control" required>
                    </div>

                    <button class=" btn btn-dark ">Add</button>

                </form>
            </div>
        </div>

    </body>