<% layout("/layouts/boilerplate")%>


    <body>

        <h3>
            <%=listing.title%>
        </h3>
        <div class="row">
            <div class="col-8 offset-2">
            </div>

            <div class="card col-6 offfset-2 listing-card">
                <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="...">
                <div class="card-body">
                    <h5 class="card-title">

                        <p class="card-text">Owned By:
                            <i><%=listing.owner.username %></i><br>
                            <%=listing.description%><br>
                                <%=listing.price %><br>
                                    <%=listing.location%><br>
                                        <%=listing.country%>
                        </p>

                </div>
            </div>
            </form>
        </div>
        <% if(currentUser  && listing.owner._id.equals(currentUser._id)) { %>
            <div class="btns">

                <a href="/listing/<%=listing._id%>/edit" class="btn btn-dark">edit</a><br>


                <form method="post" action="/listing/<%=listing._id%>/delete?_method=delete">
                    <button>Delete</button>
                </form>
                <%}%>


            </div>
            <% if(currentUser) {%>
                <div class="col-8 offset-2 mb-3">
                    <h4>Leave a Review</h4>
                    <form method="post" action="/listing/<%=listing._id%>/reviews">
                        <fieldset class="starability-basic">
                            <legend>First rating:</legend>
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>


                        <div class="mb-3 mt-3">
                            <label for="comment">comments</label><br>
                            <textarea name="review[comment]" id="comment" cols="50" rows="5"></textarea>
                        </div>
                        <button class="btn btn-outline-dark">submit</button>
                    </form>
                </div>
                <%}%>
                    <hr>
                    <p><b>All reviews</b></p>

                    <div class="row">
                        <% for(review of listing.reviews) { %>

                            <div class="card col-5 ms-3 mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%=review.author.username%>
                                    </h5>
                                    <p class="card-text">
                                        <%=review.comment%>
                                    </p>
                                    <p class="starability-result card-text" data-rating="<%=review.rating %>">
                                        Rated:
                                        <%=review.rating %> stars
                                    </p>
                                </div>
                                <% if(currentUser) {%>
                                    <form class="mb-3" method="post" action="/listing/<%=listing._id%>/reviews/<%=review._id%>?_method=delete">
                                        <button class="btn btn-sm btn-dark">Delete</button>
                                    </form>
                                    <%}%>
                            </div>

                            <%}%>
                    </div>

                    <div>
                        <h2>Location of
                            <%=listing.title %>
                        </h2>
                        <div id="map"></div>
                    </div>

                    <!-- 
                    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
                    <script>
                        var map = L.map('map').setView(["<%=listing.lat %>", "<%=listing.long %>"], 13);
                        L.tileLayer(`https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png`).addTo(map);
                        L.marker(["<%=listing.lat %>", "<%=listing.long %>"]).addTo(map)
                            .bindPopup('welcome to <%=listing.title %>,<%=listing.location %>,<%=listing.country %>').openPopup();
                    </script> -->
                    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
                    <script>
                        let lat = "<%=listing.data.lat %>";
                        let lon = "<%=listing.data.lon %>";
                        var map = L.map('map').setView([lat, lon], 13);

                        var osm = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                        });
                        osm.addTo(map);

                        L.marker([lat, lon]).addTo(map)
                            .bindPopup('<%=listing.location %>,<%=listing.country %>')
                            .openPopup();
                    </script>

    </body>